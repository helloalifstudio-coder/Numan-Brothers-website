# Nomaan Brothers CMS — use a dedicated, client-owned Supabase project.
# The public frontend key is safe ONLY when the SQL RLS migration is installed and tested.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PROJECT_PUBLIC_KEY

# NEVER put a service-role key, secret key, or database password in VITE_*.
# Staff must be manually provisioned in Supabase Auth with app_metadata.nb_role.
