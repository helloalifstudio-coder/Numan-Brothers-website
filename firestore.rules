// Legacy Firebase is retired from this branch. Deploy these restrictive rules
// to the LEGACY Firebase project only after verifying and backing up existing data.
// Committing this file does not change any remotely deployed Firebase rules.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
